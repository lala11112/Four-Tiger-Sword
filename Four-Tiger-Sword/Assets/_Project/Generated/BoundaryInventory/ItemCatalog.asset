  contentRevision: 20261108
  contentStatus: draft
  sourceJson: "{\r\n  \"version\": 1,\r\n  \"revision\": \"2026-11-08\",\r\n  \"title\":
    \"\uACBD\uACC4 ZERO \xB7 \uC778\uBCA4\uD1A0\uB9AC \uC544\uC774\uD15C 59\uC885\",\r\n 
    \"rules\": [\r\n    \"\uC218\uCE58\uB294 \uC804\uD22C \uD14C\uC2A4\uD2B8\uC6A9
    \uAE30\uD68D\uAC12\uC774\uB2E4.\",\r\n    \"\uAC19\uC740 \uC2DC\uB108\uC9C0\uC758
    \uC11C\uB85C \uB2E4\uB978 \uC544\uC774\uD15C 2\xB74\xB76\uC885\uC744 \uBCF4\uC720\uD558\uBA74
    \uD574\uB2F9 \uB2E8\uACC4\uAC00 \uC801\uC6A9\uB41C\uB2E4. \uC0C1\uC704 \uB2E8\uACC4\uAC00
    \uD558\uC704 \uB2E8\uACC4\uB97C \uB300\uCCB4\uD558\uBA70, 6\uC885 \uC774\uC0C1\uC5D0\uC11C\uB294
    6\uB2E8\uACC4 \uD6A8\uACFC\uAC00 \uC801\uC6A9\uB41C\uB2E4.\",\r\n    \"\uB450
    \uC2DC\uB108\uC9C0\uC5D0 \uC18D\uD55C \uC544\uC774\uD15C\uC740 \uC591\uCABD\uC5D0\uC11C
    \uAC01\uAC01 1\uC885\uC73C\uB85C \uC13C\uB2E4. \uAC19\uC740 \uC544\uC774\uD15C\uC758
    \uC911\uBCF5 \uD68D\uB4DD\uC740 \uC885\uB958 \uC218\uB97C \uB298\uB9AC\uC9C0
    \uC54A\uB294\uB2E4.\",\r\n    \"\uCD94\uAC00 \uD0C0\uACA9\uC740 \uBCC4\uB3C4\uC758
    \uC801\uC911\xB7\uCC98\uCE58 \uD6A8\uACFC\uB098 \uCD94\uAC00 \uD0C0\uACA9\uC744
    \uB2E4\uC2DC \uBC1C\uB3D9\uD558\uC9C0 \uC54A\uB294\uB2E4. \uC544\uC774\uD15C
    \uD6A8\uACFC\uC758 \uC7AC\uBC1C\uB3D9\uC740 \uBA85\uC2DC\uB41C \uACBD\uC6B0\uB97C
    \uC81C\uC678\uD558\uACE0 \uC9C0\uC18D\uC2DC\uAC04\uB9CC \uAC31\uC2E0\uD55C\uB2E4.\"\r\n 
    ],\r\n  \"items\": [\r\n    {\r\n      \"id\": \"I01\",\r\n      \"name\": \"\uC0C8\uC2F9
    \uBD80\uC801\",\r\n      \"description\": \"\uBD89\uC740 \uB048 \uC544\uB798
    \uC0C1\uC544\uC0C9 \uC78E \uB450 \uC7A5\uC774 \uACB9\uCCD0 \uB2EC\uB9B0 \uBD80\uC801\uC774\uB2E4.\",\r\n     
    \"effect\": \"\uCD5C\uB300 HP\uAC00 5% \uC99D\uAC00\uD55C\uB2E4.\",\r\n     
    \"synergies\": [\r\n        \"S03\"\r\n      ],\r\n      \"primarySynergy\":
    \"S03\",\r\n      \"image\": \"Art/Items/I01.png\",\r\n      \"origin\": \"existing\"\r\n   
    },\r\n    {\r\n      \"id\": \"I02\",\r\n      \"name\": \"\uC228\uACB0 \uB9E4\uB4ED\",\r\n     
    \"description\": \"\uC0C1\uC544\uC0C9 \uB048\uC744 \uD314\uC790 \uBAA8\uC591\uC73C\uB85C
    \uC5EE\uACE0 \uAC80\uC740 \uAE08\uC18D \uD638\uB8E8\uB77C\uAE30\uB97C \uB9E4\uB2EC\uC558\uB2E4.\",\r\n     
    \"effect\": \"HP\uAC00 30% \uC774\uD558\uC778 \uC801\uC744 \uD3C9\uD0C0\uB85C
    \uACF5\uACA9\uD558\uBA74 \uCE58\uBA85\uD0C0 \uD655\uB960\uC774 8%p \uC99D\uAC00\uD55C\uB2E4.
    \uC801\uC758 HP\uB294 \uC801\uC911 \uC9C1\uC804\uC5D0 \uD655\uC778\uD55C\uB2E4.\",\r\n     
    \"synergies\": [\r\n        \"S01\",\r\n        \"S10\"\r\n      ],\r\n     
    \"primarySynergy\": \"S01\",\r\n      \"image\": \"Art/Items/I02.png\",\r\n     
    \"origin\": \"existing\"\r\n    },\r\n    {\r\n      \"id\": \"I04\",\r\n     
    \"name\": \"\uB2E4\uC2DC \uD53C\uB294 \uAC00\uC9C0\",\r\n      \"description\":
    \"\uB450 \uAC08\uB798 \uC740\uBE5B \uAC00\uC9C0 \uB05D\uC5D0 \uBD89\uC740 \uAF43\uBD09\uC624\uB9AC\uAC00
    \uB9FA\uD614\uB2E4.\",\r\n      \"effect\": \"\uD654 \uC18D\uC131 \uD3C9\uD0C0\uC640
    \uC2A4\uD0AC \uD53C\uD574\uAC00 4% \uC99D\uAC00\uD55C\uB2E4.\",\r\n      \"synergies\":
    [\r\n        \"S05\"\r\n      ],\r\n      \"primarySynergy\": \"S05\",\r\n     
    \"image\": \"Art/Items/I04.png\",\r\n      \"origin\": \"revised\",\r\n     
    \"designIntent\": \"\uD3C9\uD0C0\uC640 \uC2A4\uD0AC\uC758 \uD654 \uC18D\uC131
    \uD53C\uD574\uB97C \uD568\uAED8 \uAC15\uD654\uD55C\uB2E4.\"\r\n    },\r\n   
    {\r\n      \"id\": \"I05\",\r\n      \"name\": \"\uBD88\uC528 \uC7A5\uC2DD\",\r\n     
    \"description\": \"\uC0BC\uAC01\uD615 \uAE08\uC18D \uD2C0 \uC548\uC5D0 \uC8FC\uD669\uBE5B
    \uBD88\uC528 \uC870\uAC01\uC774 \uB9E4\uB2EC\uB824 \uC788\uB2E4.\",\r\n     
    \"effect\": \"\uD654 \uC18D\uC131 \uD3C9\uD0C0 \uD53C\uD574\uAC00 8% \uC99D\uAC00\uD55C\uB2E4.\",\r\n     
    \"synergies\": [\r\n        \"S05\",\r\n        \"S02\"\r\n      ],\r\n     
    \"primarySynergy\": \"S05\",\r\n      \"image\": \"Art/Items/I05.png\",\r\n     
    \"origin\": \"revised\",\r\n      \"designIntent\": \"\uD654 \uC18D\uC131 \uD3C9\uD0C0\uB97C
    \uC8FC\uB825\uC73C\uB85C \uC4F0\uB294 \uAD6C\uC131\uC744 \uAC15\uD654\uD55C\uB2E4.\"\r\n   
    },\r\n    {\r\n      \"id\": \"I06\",\r\n      \"name\": \"\uBD89\uC740 \uC778\uC7A5\",\r\n     
    \"description\": \"\uC9E7\uC740 \uAC80\uC740 \uC190\uC7A1\uC774 \uC544\uB798
    \uBD89\uC740 \uC0AC\uAC01 \uB3C4\uC7A5\uBA74\uC774 \uB193\uC600\uB2E4.\",\r\n     
    \"effect\": \"\uCE58\uBA85\uD0C0 \uD53C\uD574 \uBC30\uC728\uC774 10%p \uC99D\uAC00\uD55C\uB2E4.\",\r\n     
    \"synergies\": [\r\n        \"S01\"\r\n      ],\r\n      \"primarySynergy\":
    \"S01\",\r\n      \"image\": \"Art/Items/I06.png\",\r\n      \"origin\": \"existing\"\r\n   
    },\r\n    {\r\n      \"id\": \"I07\",\r\n      \"name\": \"\uD0C0\uC624\uB974\uB294
    \uB9E4\uB4ED\",\r\n      \"description\": \"\uAD75\uC740 \uAC80\uC740 \uB048\uC758
    \uB9E4\uB4ED\uC744 \uC8FC\uD669\uBE5B \uC2E4\uC774 \uB530\uB77C \uAC10\uACE0
    \uC788\uB2E4.\",\r\n      \"effect\": \"\uC815\uC608\xB7\uBCF4\uC2A4\uC5D0\uAC8C
    \uC8FC\uB294 \uD654 \uC18D\uC131 \uD53C\uD574\uAC00 8% \uC99D\uAC00\uD55C\uB2E4.\",\r\n     
    \"synergies\": [\r\n        \"S05\"\r\n      ],\r\n      \"primarySynergy\":
    \"S05\",\r\n      \"image\": \"Art/Items/I07.png\",\r\n      \"origin\": \"revised\",\r\n     
    \"designIntent\": \"\uD654 \uC18D\uC131 \uACF5\uACA9\uC73C\uB85C \uC815\uC608\xB7\uBCF4\uC2A4\uB97C
    \uC0C1\uB300\uD560 \uB54C \uD53C\uD574\uB97C \uB298\uB9B0\uB2E4.\"\r\n    },\r\n   
    {\r\n      \"id\": \"I08\",\r\n      \"name\": \"\uC774\uC5B4\uC9C0\uB294 \uBD88\uAF43\",\r\n     
    \"description\": \"\uBD88\uC528\uB97C \uB2F4\uC740 \uB450 \uAE08\uC18D \uD1B5\uC774
    \uBD89\uC740 \uACBD\uCCA9\uC73C\uB85C \uC774\uC5B4\uC838 \uC788\uB2E4.\",\r\n     
    \"effect\": \"\uD654 \uC18D\uC131 \uC2A4\uD0AC \uD53C\uD574\uAC00 7% \uC99D\uAC00\uD55C\uB2E4.\",\r\n     
    \"synergies\": [\r\n        \"S05\"\r\n      ],\r\n      \"primarySynergy\":
    \"S05\",\r\n      \"image\": \"Art/Items/I08.png\",\r\n      \"origin\": \"revised\",\r\n     
    \"designIntent\": \"\uD654 \uC18D\uC131 \uC2A4\uD0AC\uC744 \uC8FC\uB825\uC73C\uB85C
    \uC4F0\uB294 \uAD6C\uC131\uC744 \uAC15\uD654\uD55C\uB2E4.\"\r\n    },\r\n   
    {\r\n      \"id\": \"I09\",\r\n      \"name\": \"\uD759\uBE5B \uBD80\uC801\",\r\n     
    \"description\": \"\uD669\uD1A0\uC0C9 \uB3C4\uC790\uAE30 \uBD80\uC801\uC758 \uAC08\uB77C\uC9C4
    \uD2C8\uC744 \uD669\uB3D9 \uAEBE\uC1E0 \uC138 \uAC1C\uAC00 \uC787\uB294\uB2E4.\",\r\n     
    \"effect\": \"\uCD5C\uB300 HP\uAC00 8% \uC99D\uAC00\uD55C\uB2E4. \uD68D\uB4DD
    \uC2DC \uD604\uC7AC HP\uB294 \uADF8\uB300\uB85C\uB2E4.\",\r\n      \"synergies\":
    [\r\n        \"S03\"\r\n      ],\r\n      \"primarySynergy\": \"S03\",\r\n     
    \"image\": \"Art/Items/I09.png\",\r\n      \"origin\": \"existing\"\r\n    },\r\n   
    {\r\n      \"id\": \"I100\",\r\n      \"name\": \"\uB9C8\uAC10 \uB798\uCE6B\",\r\n     
    \"description\": \"\uD1B1\uB2C8 \uB05D\uC774 \uBD89\uC740 \uAC80\uC740 \uC18C\uD615
    \uB798\uCE6B.\",\r\n      \"effect\": \"HP\uAC00 25% \uC774\uD558\uC778 \uC801\uC5D0\uAC8C
    \uAC00\uD558\uB294 \uD3C9\uD0C0\uC758 \uCE58\uBA85\uD0C0 \uD53C\uD574 \uBC30\uC728\uC774
    15%p \uC99D\uAC00\uD55C\uB2E4.\",\r\n      \"synergies\": [\r\n        \"S10\",\r\n       
