    {\r\n      \"id\": \"I19\",\r\n      \"name\": \"\uD750\uB974\uB294 \uB9E4\uB4ED\",\r\n     
    \"description\": \"\uC740\uBE5B \uB9AC\uBCF8\uC744 \uB290\uC2A8\uD558\uAC8C \uBB36\uACE0
