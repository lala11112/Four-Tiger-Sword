    \uC18D\uC131 \uD3C9\uD0C0 \uD53C\uD574\uAC00 8% \uC99D\uAC00\uD55C\uB2E4.\",\r\n     
    \"synergies\": [\r\n        \"S04\"\r\n      ],\r\n      \"primarySynergy\":
    \"S04\",\r\n      \"image\": \"Art/Items/I17.png\",\r\n      \"origin\": \"revised\",\r\n     
    \"designIntent\": \"\uC218 \uC18D\uC131 \uD3C9\uD0C0\uB97C \uC8FC\uB825\uC73C\uB85C
    \uC4F0\uB294 \uAD6C\uC131\uC744 \uAC15\uD654\uD55C\uB2E4.\"\r\n    },\r\n   
    {\r\n      \"id\": \"I18\",\r\n      \"name\": \"\uAE4A\uC740 \uBB3C\uBCD1\",\r\n     
    \"description\": \"\uB113\uC801\uD55C \uCCAD\uB85D\uC0C9 \uC720\uB9AC \uBAB8\uCCB4\uC5D0
    \uAC01\uC9C4 \uD669\uB3D9 \uB9C8\uAC1C\uB97C \uB07C\uC6B4 \uD734\uB300 \uBB3C\uBCD1\uC774\uB2E4.\",\r\n     
    \"effect\": \"\uC218 \uC18D\uC131 \uC2A4\uD0AC \uD53C\uD574\uAC00 7% \uC99D\uAC00\uD55C\uB2E4.\",\r\n     
