    \"\uCCB4\uB825\uC774 \uB0AE\uC740 \uC801\uC5D0\uAC8C \uAC00\uD558\uB294 \uD3C9\uD0C0
    \uCE58\uBA85\uD0C0\uB97C \uAC15\uD654\uD55C\uB2E4.\",\r\n      \"origin\": \"revised\",\r\n     
    \"image\": \"Art/Items/I100.png\"\r\n    },\r\n    {\r\n      \"id\": \"I13\",\r\n     
    \"name\": \"\uBE5B\uB098\uB294 \uC870\uAC01\",\r\n      \"description\": \"\uBD89\uC740
    \uB048\uC774 \uB2EC\uB9B0 \uAC80\uC740 \uAE08\uC18D \uD2C0\uC5D0 \uC0BC\uAC01
    \uAC70\uC6B8 \uC870\uAC01\uC774 \uBB3C\uB824 \uC788\uB2E4.\",\r\n      \"effect\":
    \"\uCE58\uBA85\uD0C0 \uD655\uB960\uC774 2%p \uC99D\uAC00\uD55C\uB2E4.\",\r\n     
    \"synergies\": [\r\n        \"S01\"\r\n      ],\r\n      \"primarySynergy\":
    \"S01\",\r\n      \"image\": \"Art/Items/I13.png\",\r\n      \"origin\": \"existing\"\r\n   
    },\r\n    {\r\n      \"id\": \"I14\",\r\n      \"name\": \"\uB9DE\uBB3C\uB9B0
    \uACE0\uB9AC\",\r\n      \"description\": \"\uBC1D\uC740 \uC1E0\uBE5B\uACFC \uC9D9\uC740
    \uD68C\uC0C9\uC758 \uD1B1\uB2C8 \uACE0\uB9AC \uB450 \uAC1C\uAC00 \uC11C\uB85C
    \uB9DE\uBB3C\uB824 \uC788\uB2E4.\",\r\n      \"effect\": \"\uD3C9\uD0C0 \uACF5\uACA9\uC18D\uB3C4\uAC00
    5% \uC99D\uAC00\uD55C\uB2E4.\",\r\n      \"synergies\": [\r\n        \"S02\"\r\n     
    ],\r\n      \"primarySynergy\": \"S02\",\r\n      \"image\": \"Art/Items/I14.png\",\r\n     
    \"origin\": \"existing\"\r\n    },\r\n    {\r\n      \"id\": \"I15\",\r\n     
    \"name\": \"\uC815\uB828\uB41C \uC778\uC7A5\",\r\n      \"description\": \"\uC9D9\uC740
    \uAC15\uCCA0 \uBC18\uC9C0 \uC704\uC5D0 \uD669\uB3D9 \uD14C\uB97C \uB450\uB978
    \uD314\uAC01\uD615 \uC0C1\uC544\uC0C9 \uC778\uC7A5\uBA74\uC774 \uB193\uC600\uB2E4.\",\r\n     
    \"effect\": \"HP\uAC00 80% \uC774\uC0C1\uC778 \uC801\uC5D0\uAC8C \uD3C9\uD0C0\uB97C
    \uB9DE\uD788\uBA74 \uC9C1\uC811 \uD53C\uD574\uAC00 12% \uC99D\uAC00\uD55C\uB2E4.
    \uC801\uC758 HP\uB294 \uC801\uC911 \uC9C1\uC804\uC5D0 \uD655\uC778\uD55C\uB2E4.\",\r\n     
    \"synergies\": [\r\n        \"S01\"\r\n      ],\r\n      \"primarySynergy\":
    \"S01\",\r\n      \"image\": \"Art/Items/I15.png\",\r\n      \"origin\": \"existing\"\r\n   
    },\r\n    {\r\n      \"id\": \"I16\",\r\n      \"name\": \"\uC624\uC0C9 \uC5F0\uACB0\uACE0\uB9AC\",\r\n     
    \"description\": \"\uAC00\uC6B4\uB370\uAC00 \uBE48 \uC740\uBE5B \uC5F0\uACB0\uAD6C
    \uB458\uB808\uC5D0 \uCC28\uBD84\uD55C \uB2E4\uC12F \uC0C9 \uC870\uAC01\uC774
    \uBC15\uD600 \uC788\uB2E4.\",\r\n      \"effect\": \"\uC218 \uC18D\uC131\uACFC
    \uD654 \uC18D\uC131 \uD53C\uD574\uAC00 \uAC01\uAC01 4% \uC99D\uAC00\uD55C\uB2E4.\",\r\n     
    \"synergies\": [\r\n        \"S05\",\r\n        \"S04\"\r\n      ],\r\n     
    \"primarySynergy\": \"S05\",\r\n      \"image\": \"Art/Items/I16.png\",\r\n     
    \"origin\": \"revised\",\r\n      \"designIntent\": \"\uC218 \uC18D\uC131\uACFC
    \uD654 \uC18D\uC131 \uACF5\uACA9\uC744 \uD568\uAED8 \uC4F0\uB294 \uAD6C\uC131\uC758
    \uD53C\uD574\uB97C \uB298\uB9B0\uB2E4.\"\r\n    },\r\n    {\r\n      \"id\":
    \"I17\",\r\n      \"name\": \"\uBB3C\uBC29\uC6B8 \uC7A5\uC2DD\",\r\n      \"description\":
    \"\uAFC0\uBE5B \uAE08\uC18D \uD14C\uAC00 \uC605\uC740 \uC7BF\uD478\uB978 \uBB3C\uBC29\uC6B8
