  sourceJson: "{\r\n  \"version\": 1,\r\n  \"revision\": \"2026-11-11\",\r\n  \"title\":
    \"\uACBD\uACC4 ZERO \xB7 \uC778\uBCA4\uD1A0\uB9AC \uC544\uC774\uD15C 77\uC885\",\r\n 
    \"rules\": [\r\n    \"\uC218\uCE58\uB294 \uC804\uD22C \uD14C\uC2A4\uD2B8\uC6A9
    \uAE30\uD68D\uAC12\uC774\uB2E4.\",\r\n    \"\uAC19\uC740 \uC2DC\uB108\uC9C0\uC758
    \uC11C\uB85C \uB2E4\uB978 \uC544\uC774\uD15C\uC744 \uBAA8\uC73C\uBA74 \uB2EC\uC131\uD55C
    \uCD5C\uACE0 \uB2E8\uACC4\uC758 \uD6A8\uACFC\uAC00 \uC801\uC6A9\uB41C\uB2E4.
    \uC218\uD655\uC740 1\xB72\xB73\uC885, \uB2E4\uB978 \uC2DC\uB108\uC9C0\uB294 2\xB74\xB76\xB78\uC885\uC744
    \uBCF4\uC720\uD560 \uB54C \uC801\uC6A9\uB41C\uB2E4.\",\r\n    \"\uB450 \uC2DC\uB108\uC9C0\uC5D0
    \uC18D\uD55C \uC544\uC774\uD15C\uC740 \uC591\uCABD\uC5D0\uC11C \uAC01\uAC01 1\uC885\uC73C\uB85C
    \uC13C\uB2E4. \uAC19\uC740 \uC544\uC774\uD15C\uC758 \uC911\uBCF5 \uD68D\uB4DD\uC740
    \uC885\uB958 \uC218\uB97C \uB298\uB9AC\uC9C0 \uC54A\uB294\uB2E4.\",\r\n    \"\uCD94\uAC00
    \uD0C0\uACA9\uC740 \uBCC4\uB3C4\uC758 \uC801\uC911\xB7\uCC98\uCE58 \uD6A8\uACFC\uB098
    \uCD94\uAC00 \uD0C0\uACA9\uC744 \uB2E4\uC2DC \uBC1C\uB3D9\uD558\uC9C0 \uC54A\uB294\uB2E4.
    \uC544\uC774\uD15C \uD6A8\uACFC\uC758 \uC7AC\uBC1C\uB3D9\uC740 \uBA85\uC2DC\uB41C
    \uACBD\uC6B0\uB97C \uC81C\uC678\uD558\uACE0 \uC9C0\uC18D\uC2DC\uAC04\uB9CC \uAC31\uC2E0\uD55C\uB2E4.\"\r\n 
    ],\r\n  \"items\": [\r\n    {\r\n      \"id\": \"I01\",\r\n      \"name\": \"\uC0C8\uC2F9
    \uBD80\uC801\",\r\n      \"description\": \"\uBD89\uC740 \uB048 \uC544\uB798
    \uC0C1\uC544\uC0C9 \uC78E \uB450 \uC7A5\uC774 \uACB9\uCCD0 \uB2EC\uB9B0 \uBD80\uC801\uC774\uB2E4.\",\r\n     
    \"effect\": \"\uCD5C\uB300 HP +5%\",\r\n      \"synergies\": [\r\n        \"S03\"\r\n     
    ],\r\n      \"primarySynergy\": \"S03\",\r\n      \"image\": \"Art/Items/I01.png\",\r\n     
    \"origin\": \"existing\",\r\n      \"grade\": 2\r\n    },\r\n    {\r\n      \"id\":
    \"I02\",\r\n      \"name\": \"\uC228\uACB0 \uB9E4\uB4ED\",\r\n      \"description\":
